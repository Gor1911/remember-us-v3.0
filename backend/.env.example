# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/remember_us

# Redis
REDIS_URL=redis://localhost:6379/0

# AWS S3 (media storage)
AWS_ACCESS_KEY_ID=your-key
AWS_SECRET_ACCESS_KEY=your-secret
AWS_STORAGE_BUCKET_NAME=remember-us-media
AWS_S3_REGION_NAME=us-east-1

# AI
LIVEPORTRAIT_API_KEY=your-liveportrait-key

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Frontend
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUST_X_FORWARDED_FOR=False

# Private media (signed URLs)
MEDIA_URL_MAX_AGE=21600
MEDIA_USE_X_ACCEL=True

# Email (password reset)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-user
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Remember US <no-reply@example.com>

# Stripe (Checkout). Leave empty to disable payments (checkout returns 503 PAYMENTS_UNAVAILABLE).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PREMIUM=
