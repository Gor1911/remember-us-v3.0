# Copy to infra/.env.prod on the VPS and fill in every CHANGE_ME.
# Replace YOUR_VPS_IP everywhere with the server's public IP (later: the domain).

# Public host (used by compose when building the frontend on the server)
PUBLIC_HOST=YOUR_VPS_IP

# Docker images (deploy.sh overrides IMAGE_TAG with the commit SHA being deployed)
IMAGE_PREFIX=ghcr.io/gor1911/remember-us
IMAGE_TAG=latest

# Process counts — sized for a 1 GB RAM VPS; raise on bigger servers
GUNICORN_WORKERS=2
CELERY_CONCURRENCY=1

# PostgreSQL
POSTGRES_DB=remember_us
POSTGRES_USER=remember_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Django
SECRET_KEY=CHANGE_ME_50_RANDOM_CHARS
DEBUG=False
ALLOWED_HOSTS=YOUR_VPS_IP,localhost
DATABASE_URL=postgres://remember_user:CHANGE_ME_STRONG_PASSWORD@db:5432/remember_us
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# CORS
CORS_ALLOWED_ORIGINS=http://YOUR_VPS_IP

# Frontend URL (used in QR links and emails)
FRONTEND_URL=http://YOUR_VPS_IP

# Email — console backend logs emails to `docker compose logs backend` until SMTP is set up.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Remember US <no-reply@example.com>

# Stripe — TEST keys only while the site runs over plain HTTP.
# Leave empty to disable payments (checkout returns 503 PAYMENTS_UNAVAILABLE).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PREMIUM=

# AWS S3 — leave empty, local storage is used
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# LivePortrait — disabled
LIVEPORTRAIT_API_KEY=
